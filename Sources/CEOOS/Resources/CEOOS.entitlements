<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CloudKit private database. This container identifier must match
	     AppEnvironment.cloudKitContainerIdentifier exactly. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.kambojventures.ceoos</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>

	<!-- The SwiftData store lives in this App Group so the widget and the
	     intents extension can read it. Decided in commit one on purpose:
	     moving a live, synced store into an App Group later is a file
	     migration on a database you depend on daily. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.kambojventures.ceoos</string>
	</array>

	<!-- CloudKit mirroring needs silent pushes to know something changed.
	     Xcode rewrites this to "production" for release builds. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
